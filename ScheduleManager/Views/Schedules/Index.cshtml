
@model IEnumerable<ScheduleManager.Models.Schedule>

@{
	ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
	<a asp-action="Create">Create New</a>
</p>
<table class="table">
	<thead>
		<tr>
			<th>
				@Html.DisplayNameFor(model => model.Subject)
			</th>
			<th>
				@Html.DisplayNameFor(model => model.DayOfWeek)
			</th>
			<th>
				@Html.DisplayNameFor(model => model.StartTime)
			</th>
			<th>
				@Html.DisplayNameFor(model => model.EndTime)
			</th>
			<th>
				@Html.DisplayNameFor(model => model.Room)
			</th>
			<th>
				@Html.DisplayNameFor(model => model.Grade)
			</th>
			<th>
				@Html.DisplayNameFor(model => model.Teacher)
			</th>
			<th></th>
		</tr>
	</thead>
	<tbody>
		@foreach (var item in Model) {
			<tr>
				<td>
					@Html.DisplayFor(modelItem => item.Subject.Description)
				</td>
				<td>
					@Html.DisplayFor(modelItem => item.DayOfWeekSpanish)
				</td>
				<td>
					@item.StartTime.ToString(@"hh\:mm")
				</td>
				<td>
					@item.EndTime.ToString(@"hh\:mm")
				</td>
				<td>
					@Html.DisplayFor(modelItem => item.Room.Description)
				</td>
				<td>
					@Html.DisplayFor(modelItem => item.Grade.Description)
				</td>
				<td>
					@Html.DisplayFor(modelItem => item.Teacher.Fullname)
				</td>
				<td>
					<a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
					<a asp-action="Details" asp-route-id="@item.Id">Details</a> |
					<a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
				</td>
			</tr>
		}
	</tbody>
</table>
